// spikformer_cfg.vh - include SHAPE (not values). Values come from the
// per-build generated spikformer_config.vh (codegen writes it into the
// build output include path; never a shared global hyper_para.v).
`ifndef SPIKFORMER_CFG_VH
`define SPIKFORMER_CFG_VH
// Expected generated defines (documented here, defined by codegen):
//   SPIK_T, SPIK_DEPTH, SPIK_EMBED, SPIK_HEADS, SPIK_HEAD_DIM,
//   SPIK_MLP_HIDDEN, SPIK_TOKENS, SPIK_SPIKE_BITS, SPIK_RES_BITS,
//   SPIK_SUM_W, SPIK_HEAD_NORM (0=sum,1=ps_div,2=folded)
`endif
