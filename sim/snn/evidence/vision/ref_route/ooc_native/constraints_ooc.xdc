# GENERATED by synth_ooc_vis_native.tcl: single 5.000 ns clock.
# OOC boundary model: every data input/output at 0.000 ns (the owning
# platform wrapper registers these streams). No exceptions, no downclock.
create_clock -name s_clk -period 5.000 [get_ports s_clk]
set_input_delay  -clock s_clk 0.000 [all_inputs -no_clocks]
set_output_delay -clock s_clk 0.000 [all_outputs]
